<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bill category"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pay from account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="15dp" />

        <Spinner
            android:id="@+id/spinner_payerAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bill / consumer number"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="15dp" />

        <EditText
            android:id="@+id/editText_billNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Bill number"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amount"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="15dp" />

        <EditText
            android:id="@+id/editText_billAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Amount"
            android:singleLine="true"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <Button
            android:id="@+id/button_payBill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Pay Bill"
            android:padding="15dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/wallet_bright_foreground_holo_dark"
            android:background="@drawable/roundbutton" />

        <TextView
            android:id="@+id/textView_billResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:paddingTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payment history"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp" />

        <ListView
            android:id="@+id/listView_billHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp"></ListView>

        <Button
            android:id="@+id/button_refreshBills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Refresh History"
            android:padding="15dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/wallet_bright_foreground_holo_dark"
            android:background="@drawable/roundbutton" />

    </LinearLayout>

</ScrollView>
