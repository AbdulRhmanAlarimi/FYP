<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a new account"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="Username 3-50 characters (letters, digits, dot, underscore, dash). Password at least 6 characters."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editText_signupUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Username"
            android:singleLine="true"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <EditText
            android:id="@+id/editText_signupPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Password"
            android:password="true"
            android:singleLine="true"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <EditText
            android:id="@+id/editText_signupConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Repeat password"
            android:password="true"
            android:singleLine="true"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <EditText
            android:id="@+id/editText_signupFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="First name"
            android:singleLine="true"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <EditText
            android:id="@+id/editText_signupLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Last name"
            android:singleLine="true"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <EditText
            android:id="@+id/editText_signupEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Email (optional)"
            android:singleLine="true"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <EditText
            android:id="@+id/editText_signupPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Phone number (optional)"
            android:singleLine="true"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <EditText
            android:id="@+id/editText_signupAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="Address (optional)"
            android:background="@android:drawable/editbox_background"
            android:padding="15dp" />

        <Button
            android:id="@+id/button_createAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Create Account"
            android:padding="15dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/wallet_bright_foreground_holo_dark"
            android:background="@drawable/roundbutton" />

        <TextView
            android:id="@+id/textView_signupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
