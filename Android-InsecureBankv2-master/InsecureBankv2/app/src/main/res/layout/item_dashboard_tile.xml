<?xml version="1.0" encoding="utf-8"?>
<!--
    One tile of the PostLogin dashboard grid. Inflated by PostLogin.DashboardAdapter, so it
    must not contain a fixed android:id - every cell reuses the same ids.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/dashboard_tile"
    android:padding="8dp">

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/wallet_bright_foreground_holo_dark"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
