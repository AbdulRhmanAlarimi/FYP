<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/textView_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account Holder"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="10dp" />

        <TextView
            android:id="@+id/textView_primaryAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account Number"
            android:textSize="18sp"
            android:paddingTop="20dp" />

        <TextView
            android:id="@+id/textView_primaryType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account Type"
            android:textSize="18sp"
            android:paddingTop="10dp" />

        <TextView
            android:id="@+id/textView_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Balance"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="10dp"
            android:textColor="#ff008000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All accounts of this customer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="25dp" />

        <ListView
            android:id="@+id/listView_accounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="120dp"></ListView>

        <Button
            android:id="@+id/button_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Refresh"
            android:padding="15dp"
            android:textColor="@color/wallet_bright_foreground_holo_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/roundbutton" />

    </LinearLayout>

</ScrollView>
