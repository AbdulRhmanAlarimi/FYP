<?xml version="1.0" encoding="utf-8"?>
<!--
    Tile background for the PostLogin dashboard grid.

    Deliberately a lighter tint than roundbutton.xml (the full width action buttons) so
    that a grid of nine of them does not read as one solid blue block, and so that the
    Logout button at the bottom still stands out as the odd one out.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#1F6FB0"
                android:endColor="#1F6FB0"
                android:angle="270" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2D8CD6" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#1F6FB0" />
        </shape>
    </item>
</selector>
