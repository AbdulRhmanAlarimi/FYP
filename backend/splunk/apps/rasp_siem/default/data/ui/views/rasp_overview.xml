<?xml version="1.0" encoding="utf-8"?>
<dashboard version="1.1" theme="dark">
  <label>RASP SIEM Overview</label>
  <description>InsecureBankv2 RASP events (index=main). Open this app if the Splunk home page looks empty.</description>

  <row>
    <panel>
      <title>Events (last 24h)</title>
      <single>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-24h | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0x53a051","0x0877a6","0xf8be34","0xf1813f","0xdc4e41"]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Alerts (last 24h)</title>
      <single>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-24h alert.severity=* | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Critical alerts</title>
      <single>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-24h alert.severity=critical | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Failed logins</title>
      <single>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-24h event_id=ME-06 data.login_result=FAILED | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="drilldown">none</option>
        <option name="useColors">1</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Event rate by type</title>
      <chart>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-6h | timechart span=10m count by event_type</query>
          <earliest>-6h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
    <panel>
      <title>Alert severity mix</title>
      <chart>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-24h alert.severity=* | stats count by alert.severity</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Top banking API paths (ME-10)</title>
      <chart>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-24h event_id=ME-10 | top limit=10 data.url_path</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Hottest screens (ME-09)</title>
      <chart>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-24h event_id=ME-09 | top limit=10 component</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Environment threats (ME-11 / ME-14 / ME-15)</title>
      <chart>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-6h (event_id=ME-11 OR event_id=ME-14 OR event_id=ME-15) (data.detection_result=DETECTED OR data.debugger_state=ATTACHED) | timechart span=10m count by event_id</query>
          <earliest>-6h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Latest alerts</title>
      <table>
        <search>
          <query>index=main sourcetype=rasp:json earliest=-24h alert.severity=* | sort - _time | table _time alert.severity alert.title alert.reason event_id event_type component | head 20</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">20</option>
      </table>
    </panel>
  </row>
</dashboard>
